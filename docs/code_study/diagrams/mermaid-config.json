{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "PingFang SC, Microsoft YaHei, sans-serif",
    "fontSize": "17px",
    "primaryColor": "#eaf2ff",
    "primaryBorderColor": "#3566ae",
    "primaryTextColor": "#162d4d",
    "lineColor": "#596b80",
    "secondaryColor": "#fff2d9",
    "tertiaryColor": "#f6f8fb"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": false,
    "wrappingWidth": 280,
